{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"files": { "includes": ["src/**/*.js", "src/**/*.jsx"] },
	"formatter": { "enabled": false },
	"assist": { "enabled": false },
	"linter": {
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error",
				"useExhaustiveDependencies": "error"
			}
		}
	},
	"javascript": {
		"globals": [
			"afterAll",
			"afterEach",
			"beforeAll",
			"beforeEach",
			"describe",
			"expect",
			"it",
			"test",
			"vi"
		]
	}
}
